---
import { Image } from 'astro:assets'
---

<header class="header">
  <div class="avatar">
    <Image
      width="64"
      height="64"
      alt="hashfriend.eth"
      src="https://ipfs.euc.li/ipfs/QmcnH4s1y7PJjcgmwDriH5a5TK1nqYSwLCT8gYNrZ8ett1/993.png"
    />
  </div>
  <h1 class="title">hashfriend.eth</h1>
</header>

<style>
  .header {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;

    h1 {
      font-size: 1.2rem;
      margin: 0;
    }
  }

  .avatar {
    border-radius: 50%;
    overflow: hidden;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border: 2px solid var(--text-color);
  }
</style>

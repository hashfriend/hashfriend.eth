{
  "name": "hashfriend.eth",
  "type": "module",
  "version": "0.0.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/**' build",
    "lint": "bun run --filter './packages/**' lint",
    "format": "bun run --filter './packages/**' format",
    "typecheck": "bun run --filter './packages/**' typecheck",
    "deploy": "cd ./packages/deploy && bun run deploy",
    "dev": "cd ./packages/web && bun run dev"
  },
  "dependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/bun": "1.3.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.0"
}

---
import { execSync } from 'node:child_process'

const REPO_URL = 'https://github.com/hashfriend/hashfriend.eth'

// Resolved at build time: the deployed site is a static snapshot of one commit.
let commit: string | null = null
try {
  commit = execSync('git rev-parse --short HEAD', {
    encoding: 'utf8',
    stdio: ['ignore', 'pipe', 'ignore']
  }).trim()
} catch {
  commit = null
}
---

<footer class="footer">
  <nav class="links">
    <a href="https://x.com/hashfriend" rel="noopener">x</a>
    <a href="https://github.com/hashfriend" rel="noopener">github</a>
  </nav>
  {
    commit && (
      <a class="commit" href={`${REPO_URL}/commit/${commit}`} rel="noopener">
        {commit}
      </a>
    )
  }
</footer>

<style>
  .footer {
    margin-block-start: auto;
    padding-block-start: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .links {
    display: flex;
    gap: 1rem;
  }

  a {
    color: inherit;
    opacity: 0.6;
    font-size: 0.7rem;
    text-decoration: none;
  }

  a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .commit {
    font-size: 0.6rem;
  }
</style>

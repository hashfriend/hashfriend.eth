---
import { execSync } from 'node:child_process'

const REPO_URL = 'https://github.com/hashfriend/hashfriend.eth'

// Resolved at build time: the deployed site is a static snapshot of one commit.
let commit: string | null = null
try {
  commit = execSync('git rev-parse --short HEAD', {
    encoding: 'utf8',
    stdio: ['ignore', 'pipe', 'ignore']
  }).trim()
} catch {
  commit = null
}
---

<footer class="footer">
  <nav class="links">
    <a href="https://x.com/hashfriend" rel="noopener" aria-label="x">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932zM4.298 3.24h2.188l13.163 17.404H17.61z"
        />
      </svg>
    </a>
    <a href="https://github.com/hashfriend" rel="noopener" aria-label="github">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
        />
      </svg>
    </a>
  </nav>
  {
    commit && (
      <a class="commit" href={`${REPO_URL}/commit/${commit}`} rel="noopener">
        {commit}
      </a>
    )
  }
</footer>

<style>
  .footer {
    margin-block-start: auto;
    padding-block-start: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  @media (width >= 500px) {
    .footer {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .links {
    display: flex;
    gap: 1rem;
  }

  .links a {
    display: flex;
  }

  svg {
    width: 0.9rem;
    height: 0.9rem;
    fill: currentColor;
  }

  a {
    color: inherit;
    opacity: 0.6;
    font-size: 0.7rem;
    text-decoration: none;
  }

  a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .commit {
    font-size: 0.6rem;
  }
</style>

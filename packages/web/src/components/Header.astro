---
import { Image } from 'astro:assets'
---

<header class="header">
  <a href="/" class="home">
    <div class="avatar">
      <Image
        width="64"
        height="64"
        alt="hashfriend.eth"
        src="https://ipfs.euc.li/ipfs/QmcnH4s1y7PJjcgmwDriH5a5TK1nqYSwLCT8gYNrZ8ett1/993.png"
      />
    </div>
    <span class="title">hashfriend.eth</span>
  </a>
</header>

<style>
  .header {
    width: 100%;
    margin-bottom: 1.5rem;
  }

  .home {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    color: var(--title-color);
    text-decoration: none;
  }

  .title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
  }

  .home:hover .title {
    text-decoration: underline;
  }

  .avatar {
    border-radius: 50%;
    overflow: hidden;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border: 2px solid var(--text-color);
  }
</style>
